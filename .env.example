# izayoi environment variables
#
# Copy this file to `.env` and fill in the keys for the providers you want to use.
# Keys are read from the process environment only. They are never stored in the
# database, written to logs, or shown in the UI.
#
# The Mock provider is always available and needs no key, so you can try every
# feature without any of the variables below.

# --- Cloud LLM providers -------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=        # GOOGLE_API_KEY is also accepted
XAI_API_KEY=
ZAI_API_KEY=

# --- Optional overrides --------------------------------------------------
# Embedding model used for idea dedup (LiteLLM model string).
# Falls back to a numpy-only TF-IDF implementation when no usable key exists.
#EMBEDDING_MODEL=openai/text-embedding-3-small

# Server bind address / port (defaults shown). Bind is local-only by default.
#IZAYOI_HOST=127.0.0.1
#IZAYOI_PORT=8787

# SQLite database file location.
#IZAYOI_DB_PATH=izayoi.db
